PORT=3000
NODE_ENV=development

# Dev local:
MONGODB_URI=mongodb://localhost:27017/medagenda
# Producao (MongoDB Atlas):
# MONGODB_URI=mongodb+srv://<user>:<senha>@cluster.mongodb.net/medagenda

# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=gere_com_crypto_randomBytes_64_minimo
JWT_REFRESH_SECRET=gere_com_valor_diferente_do_access
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Anos até expiração automática das consultas (MongoDB TTL — padrão: 2 anos)
APPOINTMENT_EXPIRY_YEARS=2

# URL base usada para gerar os links do WhatsApp (confirmar, reagendar, avaliar)
APP_URL=http://localhost:8080

# URL(s) do frontend autorizadas pelo CORS (separar por virgula para multiplas)
FRONTEND_URL=http://localhost:8080

# ─── Stripe (stripe.com) ──────────────────────────────────────
# Chaves em: dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_SUBSTITUA_PELA_SUA_CHAVE

# Webhook secret: stripe listen --forward-to localhost:3000/api/v1/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_SUBSTITUA_PELO_SECRET_DO_WEBHOOK

# Price IDs criados no Dashboard (Produtos → Preços → copiar ID)
STRIPE_PRICE_ESSENCIAL_MONTHLY=price_ESSENCIAL_MENSAL
STRIPE_PRICE_ESSENCIAL_ANNUAL=price_ESSENCIAL_ANUAL
STRIPE_PRICE_PROFISSIONAL_MONTHLY=price_PROFISSIONAL_MENSAL
STRIPE_PRICE_PROFISSIONAL_ANNUAL=price_PROFISSIONAL_ANUAL

# ─── Email via Resend (resend.com) ────────────────────────────
# Crie sua chave em: resend.com/api-keys
RESEND_API_KEY=re_SUBSTITUA_PELA_SUA_CHAVE

# Remetente: use "onboarding@resend.dev" para testes sem dominio proprio.
# EMAIL_FROM_ADDRESS deve ser só o e-mail puro — o EmailService já monta "Nome <email>" a partir dos dois campos.
EMAIL_FROM_ADDRESS=noreply@seudominio.com.br
EMAIL_FROM_NAME=CliniQ

# Caixa que recebe os chamados de suporte enviados pelos médicos.
# Sem essa variável, cai no fallback EMAIL_FROM_ADDRESS — que normalmente é um
# "noreply@" não monitorado, então o chamado nunca chega a lugar nenhum de verdade.
SUPPORT_EMAIL=suporte@seudominio.com.br

# ─── Google OAuth (login "Entrar com Google") ──────────────────
# console.cloud.google.com → Credenciais → ID do cliente OAuth 2.0 (Aplicativo da Web)
GOOGLE_CLIENT_ID=SUBSTITUA_PELO_CLIENT_ID.apps.googleusercontent.com

# ─── Reunião automática (Jitsi Meet) ────────────────────────────
# Sem chave/conta nenhuma — o link é só uma URL montada em JitsiMeetingService.js.
# Opcional: aponte pro seu próprio servidor Jitsi self-hosted em vez do público (meet.jit.si).
# JITSI_DOMAIN=meet.suaempresa.com.br
